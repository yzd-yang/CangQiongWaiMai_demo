# 复制为 deploy/.env 后按本机修改（compose 会自动读取同目录 .env）
# cp .env.example .env

# MySQL root 密码（与各服务 application-local.yaml 保持一致）
MYSQL_ROOT_PASSWORD=123

# Seata 对外宣告的 IP：业务服务在「宿主机 IDE」启动时，必须填宿主机可达地址
# - Docker Desktop 本机联调：127.0.0.1
# - 群晖 / Linux 服务器（当前仓库常用）：192.168.6.128
# - 使用 --profile apps 把业务服务也打进容器：seata
SEATA_IP=192.168.6.128
